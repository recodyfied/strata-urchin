/*
 *
 *     ███████╗████████╗██████╗  █████╗ ████████╗ █████╗ 
 *     ██╔════╝╚══██╔══╝██╔══██╗██╔══██╗╚══██╔══╝██╔══██╗
 *     ███████╗   ██║   ██████╔╝███████║   ██║   ███████║
 *     ╚════██║   ██║   ██╔══██╗██╔══██║   ██║   ██╔══██║
 *     ███████║   ██║   ██║  ██║██║  ██║   ██║   ██║  ██║
 *     ╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝
 *
 * A highly personalised ZMK keymap for a split 34-key keyboard.
 *
 *              ╭───╮                      ╭───╮          
 *          ╭───┤ F ├───╮              ╭───┤ U ├───╮      
 *      ╭───┤ W ├───┤ P ├───╮      ╭───┤ L ├───┤ Y ├───╮  
 *      │ Q ├───┤ S ├───┤ B │      │ J ├───┤ E ├───┤ ; │  
 *      ├───┤ S ├───┤ T ├───┤      ├───┤ N ├───┤ I ├───┤  
 *      │ A ├───┤ C ├───┤ G │      │ M ├───┤ , ├───┤ O │  
 *      ├───┤ X ├───┤ D ├───┤      ├───┤ H ├───┤ . ├───┤  
 *      │ A ├───╯   ╰───┤ V │      │ K ├───╯   ╰───┤ ' │  
 *      ╰───╯           ╰───┘      ╰───╯           ╰───╯  
 *                    ╭───╮          ╭───╮                
 *                    │ 󰌒 ├───╮  ╭───┤ 󰌑 │                
 *                    ╰───┤ 󱁐 │  │ 󰭜 ├───╯                
 *                        ╰───╯  ╰───╯                    
 *
 * This keymap was developed for use on the Ferris Sweep; however,
 * any 34-key keyboard should be able to use this same keymap with
 * only a few small tweaks to the configuration.
 *
 */


#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/mouse.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/34.h"


// Layer definitions
// =================
#define BASE 0
#define GAME 1
#define NAV 2
#define FN 3
#define MOUSE 4
#define LAUNCH 5


/* Key labels
 * ==========
 * ╭─────────────────────╮ ╭─────────────────────╮
 * │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
 * │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
 * │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
 * ╰───────────╮ LH1 LH0 │ │ RH0 RH1 ╭───────────╯
 *             ╰─────────╯ ╰─────────╯
 */


// Custom behaviours
// =================
#define KEYS_LEFT LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4   // left hand
#define KEYS_RIGHT RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right hand
#define KEYS_THUMBS LH1 LH0 RH0 RH1                                             // thumb clusters

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        bindings = <HOLD>, <TAP>; \
        tapping-term-ms = <200>; \
        quick-tap-ms = <200>; \
        require-prior-idle-ms = <125>; \
        flavor = "balanced"; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )

MAKE_HRM(hrml, &kp, &kp, KEYS_RIGHT KEYS_THUMBS)  // left-hand HRMs
MAKE_HRM(hrmr, &kp, &kp, KEYS_LEFT KEYS_THUMBS)   // right-hand HRMs

// HRM combo hack - workaround for lack of tap-only combos (ZMK issue #544)
#define HRM_COMBO(NAME, HOLD, TAP, KEYPOS, LAYERS, COMBO_TERM, COMBO_IDLE, HOLD_TRIGGER_POS) \
    MAKE_HRM(hrm_combo_ ## NAME, &kp, &kp, HOLD_TRIGGER_POS) \
    ZMK_COMBO(NAME, &hrm_combo_ ## NAME HOLD TAP, KEYPOS, LAYERS, COMBO_TERM, COMBO_IDLE)


// Combo definitions
// =================
// NOTE: This section MUST be AFTER the home row mod hack above

// All the keys in `key-positions` must be pressed within `timeout-ms` milliseconds to trigger the
// combo.
#define COMBO_TIMEOUT_FAST 30
#define COMBO_TIMEOUT_SLOW 60

// If any non-modifier key is pressed within `require-prior-idle-ms` before a key in the combo, the
// combo will not trigger.
#define COMBO_IDLE_LONG 150
#define COMBO_IDLE_SHORT 50

/* Left - Split combos
 *   Copy        󰈆  Escape        Paste
 * ┌─┬▄┬─┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐
 * ├─┼▀┼─┼▀┼─┤    ├─┼▄┼─┼▄┼─┤    ├─┼─┼─┼─┼─┤
 * ├─┼─┼─┼─┼─┤    ├─┼▀┼─┼▀┼─┤    ├─┼▄┼─┼▄┼─┤
 * └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴─┴▀┴─┘
 *        ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 *        └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(copy, &kp C_AC_COPY, LT1 LT3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(paste, &kp C_AC_PASTE, LB1 LB3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
HRM_COMBO(escape, LS(LALT), ESCAPE, LM1 LM3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT, KEYS_RIGHT)

/* Left - Horizontal combos
 * ~ Tilde        ` Grave        _ Underscore   - Minus        + Plus         = Equal    
 * ┌─┬▄┬▄┬─┬─┐    ┌─┬─┬▄┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐ 
 * ├─┼▀┼▀┼─┼─┤    ├─┼─┼▀┼▀┼─┤    ├─┼▄┼▄┼─┼─┤    ├─┼─┼▄┼▄┼─┤    ├─┼─┼─┼─┼─┤    ├─┼─┼─┼─┼─┤ 
 * ├─┼─┼─┼─┼─┤    ├─┼─┼─┼─┼─┤    ├─┼▀┼▀┼─┼─┤    ├─┼─┼▀┼▀┼─┤    ├─┼▄┼▄┼─┼─┤    ├─┼─┼▄┼▄┼─┤ 
 * └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴▀┴─┴─┘    └─┴─┴▀┴▀┴─┘ 
 *        ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 *        └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(tilde, &kp TILDE, LT2 LT3, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG)
ZMK_COMBO(grave, &kp GRAVE, LT1 LT2, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG)
ZMK_COMBO(plus, &kp PLUS, LB2 LB3, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG)
ZMK_COMBO(equal, &kp EQUAL, LB1 LB2, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG)
HRM_COMBO(underscore, LC(LALT), UNDERSCORE, LM2 LM3, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG, KEYS_RIGHT)
HRM_COMBO(minus, LS(LCTRL), MINUS, LM1 LM2, BASE NAV GAME, COMBO_TIMEOUT_FAST, COMBO_IDLE_LONG, KEYS_RIGHT)

/* Left - Vertical combos
 * # Hash         $ Dollar       ? Question     / Fslash       ! Exclamation  @ At    
 * ┌─┬─┬─┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬▄┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬▄┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐ 
 * ├─┼─┼─┼█┼─┤    ├─┼─┼─┼▄┼─┤    ├─┼─┼█┼─┼─┤    ├─┼─┼▄┼─┼─┤    ├─┼█┼─┼─┼─┤    ├─┼▄┼─┼─┼─┤ 
 * ├─┼─┼─┼▀┼─┤    ├─┼─┼─┼█┼─┤    ├─┼─┼▀┼─┼─┤    ├─┼─┼█┼─┼─┤    ├─┼▀┼─┼─┼─┤    ├─┼█┼─┼─┼─┤ 
 * └─┴─┴─┴─┴─┘    └─┴─┴─┴▀┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴▀┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴─┴─┴─┘ 
 *        ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 *        └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(exclamation, &kp EXCLAMATION, LM3 LT3, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(question, &kp QUESTION, LM2 LT2, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(hash, &kp HASH, LM1 LT1, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(at, &kp AT, LB3 LM3, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(fslash, &kp FSLH, LB2 LM2, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(dollar, &kp DOLLAR, LB1 LM1, BASE NAV GAME, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)

/* Right - Split combos
 *   Cut            Undo          Redo
 *  ┌─┬▄┬─┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐
 *  ├─┼▀┼─┼▀┼─┤    ├─┼▄┼─┼▄┼─┤    ├─┼─┼─┼─┼─┤
 *  ├─┼─┼─┼─┼─┤    ├─┼▀┼─┼▀┼─┤    ├─┼▄┼─┼▄┼─┤
 *  └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴─┴▀┴─┘
 * ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 * └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(cut, &kp C_AC_CUT, RT1 RT3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
ZMK_COMBO(redo, &kp C_AC_REDO, RB1 RB3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT)
HRM_COMBO(undo, RS(RALT), C_AC_UNDO, RM1 RM3, ALL, COMBO_TIMEOUT_SLOW, COMBO_IDLE_SHORT, KEYS_LEFT)

/* Right - Horizontal combos
 * [ L bracket    ] R bracket    ( L paren      ) R paren      { L curly      } R curly    
 *  ┌─┬▄┬▄┬─┬─┐    ┌─┬─┬▄┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐ 
 *  ├─┼▀┼▀┼─┼─┤    ├─┼─┼▀┼▀┼─┤    ├─┼▄┼▄┼─┼─┤    ├─┼─┼▄┼▄┼─┤    ├─┼─┼─┼─┼─┤    ├─┼─┼─┼─┼─┤ 
 *  ├─┼─┼─┼─┼─┤    ├─┼─┼─┼─┼─┤    ├─┼▀┼▀┼─┼─┤    ├─┼─┼▀┼▀┼─┤    ├─┼▄┼▄┼─┼─┤    ├─┼─┼▄┼▄┼─┤ 
 *  └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴▀┴─┴─┘    └─┴─┴▀┴▀┴─┘ 
 * ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 * └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(lbracket,    &kp LEFT_BRACKET,      RT1 RT2,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG)
ZMK_COMBO(rbracket,    &kp RIGHT_BRACKET,     RT2 RT3,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG)
ZMK_COMBO(lbrace,      &kp LEFT_BRACE,        RB1 RB2,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG)
ZMK_COMBO(rbrace,      &kp RIGHT_BRACE,       RB2 RB3,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG)
HRM_COMBO(lpar,        RS(RCTRL), LPAR,       RM1 RM2,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG,   KEYS_LEFT)
HRM_COMBO(rpar,        RC(RALT),  RPAR,       RM2 RM3,      BASE NAV GAME,  COMBO_TIMEOUT_FAST,  COMBO_IDLE_LONG,   KEYS_LEFT)

/* Right - Vertical combos
 * & Ampersand    * Asterisk     | Pipe         \ Bslash       % Percent      ^ Caret
 *  ┌─┬─┬─┬▄┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬─┬▄┬─┬─┐    ┌─┬─┬─┬─┬─┐    ┌─┬▄┬─┬─┬─┐    ┌─┬─┬─┬─┬─┐ 
 *  ├─┼─┼─┼█┼─┤    ├─┼─┼─┼▄┼─┤    ├─┼─┼█┼─┼─┤    ├─┼─┼▄┼─┼─┤    ├─┼█┼─┼─┼─┤    ├─┼▄┼─┼─┼─┤ 
 *  ├─┼─┼─┼▀┼─┤    ├─┼─┼─┼█┼─┤    ├─┼─┼▀┼─┼─┤    ├─┼─┼█┼─┼─┤    ├─┼▀┼─┼─┼─┤    ├─┼█┼─┼─┼─┤ 
 *  └─┴─┴─┴─┴─┘    └─┴─┴─┴▀┴─┘    └─┴─┴─┴─┴─┘    └─┴─┴▀┴─┴─┘    └─┴─┴─┴─┴─┘    └─┴▀┴─┴─┴─┘ 
 * ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐          ┌─┬─┐
 * └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘          └─┴─┘
 */
ZMK_COMBO(percent,     &kp PERCENT,           RT1 RM1,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)
ZMK_COMBO(pipe,        &kp PIPE,              RT2 RM2,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)
ZMK_COMBO(ampersand,   &kp AMPERSAND,         RT3 RM3,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)
ZMK_COMBO(caret,       &kp CARET,             RM1 RB1,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)
ZMK_COMBO(bslash,      &kp BSLH,              RM2 RB2,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)
ZMK_COMBO(asterisk,    &kp ASTERISK,          RM3 RB3,      BASE NAV GAME,  COMBO_TIMEOUT_SLOW,  COMBO_IDLE_SHORT)


// Mouse
// =====
#include "mouse.dtsi"


/*
 * Base Layer
 * ==========
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │ Q │ W │ F │ P │ B │      │ J │ L │ U │ Y │ ; │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ A │ R │ S │ T │ G │      │ M │ N │ E │ I │ O │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ Z │ X │ C │ D │ V │      │ K │ H │ , │ . │ ' │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │ 󰌒 │ 󱁐 │  │ 󰭜 │ 󰌑 │            
 *               └───┴───┘  └───┴───┘            
 */
ZMK_LAYER(base,
    &kp Q         &kp W         &kp F          &kp P           &kp B            &kp J                &kp L                 &kp U          &kp Y         &kp SEMI
    &hrml LGUI A  &hrml LALT R  &hrml LCTRL S  &hrml LSHIFT T  &kp G            &kp M                &hrmr RSHIFT N        &hrmr RCTRL E  &hrmr RALT I  &hrmr RGUI O
    &kp Z         &kp X         &kp C          &kp D           &kp V            &kp K                &kp H                 &kp COMMA      &kp DOT       &kp SQT
                                               &lt FN TAB      &lt NAV SPACE    &lt MOUSE BACKSPACE  &lt LAUNCH RETURN
)

/*
 * Game Layer
 * ==========
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │ Q │ W │ F │ P │ B │      │ J │ L │ U │ Y │ 󰈆 │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ A │ R │ S │ T │ G │      │ M │ N │ E │ I │ O │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ Z │ X │ C │ D │ V │      │ K │ H │ , │ . │ ' │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │ 󰌒 │ 󱁐 │  │ 󰭜 │ 󰌑 │            
 *               └───┴───┘  └───┴───┘            
 */
ZMK_LAYER(game,
    &kp Q  &kp W  &kp F  &kp P       &kp B        &kp J                &kp L              &kp U      &kp Y    &tog GAME
    &kp A  &kp R  &kp S  &kp T       &kp G        &kp M                &kp N              &kp E      &kp I    &kp O
    &kp Z  &kp X  &kp C  &kp D       &kp V        &kp K                &kp H              &kp COMMA  &kp DOT  &kp SQT
                         &lt FN TAB  &kp SPACE    &lt MOUSE BACKSPACE  &lt LAUNCH RETURN
)

/*
 * Navigation/Number Layer
 * =======================
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │   │ 7 │ 8 │ 9 │   │      │   │  │  │  │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ 0 │ 4 │ 5 │ 6 │   │      │ 󰮫 │  │  │  │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ . │ 1 │ 2 │ 3 │   │      │   │   │   │   │   │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │   │  │  │ 󰭜 │ 󰹿 │            
 *               └───┴───┘  └───┴───┘            
 */
ZMK_LAYER(nav,
    &trans          &kp N7         &kp N8          &kp N9           &trans  &trans         &kp HOME       &kp PG_DN     &kp PG_UP  &kp END
    &hrml LGUI N0   &hrml LALT N4  &hrml LCTRL N5  &hrml LSHIFT N6  &trans  &kp K_CMENU    &kp LEFT       &kp DOWN      &kp UP     &kp RIGHT
    &kp DOT         &kp N1         &kp N2          &kp N3           &trans  &trans         &trans         &trans        &trans     &trans
                                                   &trans           &trans  &kp BACKSPACE  &kp DELETE
)

/*
 * Function/Media Layer
 * ====================
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │ 󱊶 │ 󱊱 │ 󱊲 │ 󱊳 │  │      │ ⏻ │   │ 󰃞 │ 󰃠 │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ 󱊵 │ 󱊮 │ 󱊯 │ 󱊰 │ 󰘲 │      │  │  │  │  │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ 󱊴 │ 󱊫 │ 󱊬 │ 󱊭 │  │      │  │  │  │  │  │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │  │   │  │  │ 󰐎 │            
 *               └───┴───┘  └───┴───┘            
 */
ZMK_LAYER(fn,
    &kp F12  &kp F7  &kp F8  &kp F9  &tog GAME     &kp C_POWER  &trans            &kp C_BRIGHTNESS_DEC               &kp C_BRIGHTNESS_INC  &kp C_AL_LOCK
    &kp F11  &kp F4  &kp F5  &kp F6  &caps_word    &kp RG(A)    &kp C_PREV        &kp C_VOL_DN                       &kp C_VOL_UP          &kp C_NEXT
    &kp F10  &kp F1  &kp F2  &kp F3  &kp PSCRN     &kp RG(V)    &kp LG(HOME)      &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp LGUI              &kp LG(END)
                             &trans  &trans        &kp C_MUTE   &kp C_PLAY_PAUSE
)

/*
 * Connectivity/Mouse Layer
 * ========================
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │  │   │   │   │ 󰮱 │      │   │  │  │  │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │   │ 1 │ 2 │ 3 │ 󰂱 │      │   │  │  │  │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │   │ 4 │ 5 │   │ 󰮳 │      │   │  │ 󰠳 │  │   │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │ 󰳽 │ 󰮫 │  │  │   │            
 *               └───┴───┘  └───┴───┘            
 */
#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

// Config from @caksoylar, defaults in comments
&mmv {
  acceleration-exponent = <2>;      // 1
  time-to-max-speed-ms = <300>;     // 300
  delay-ms = <0>;                   // 0
};

&msc {
  acceleration-exponent = <2>;      // 0
  time-to-max-speed-ms = <40>;      // 300
  delay-ms = <0>;                   // 0
};

ZMK_LAYER(ms,
    &bt BT_CLR   &trans        &trans        &trans        &bt BT_NXT      &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
    &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &out OUT_TOG    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
    &trans       &bt BT_SEL 3  &bt BT_SEL 4  &trans        &bt BT_PRV      &trans  &mkp MB4        &mkp MCLK       &mkp MB5      &trans
                                             &mkp LCLK     &mkp RCLK       &trans  &trans
)

/*
 * Launch Layer
 * ============
 * ┌───┬───┬───┬───┬───┐      ┌───┬───┬───┬───┬───┐
 * │   │  │  │  │  │      │  │ 󰧮 │  │ 󰐨 │  │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │ 󰃬 │   │  │  │  │      │  │  │  │  │ 󰖸 │
 * ├───┼───┼───┼───┼───┤      ├───┼───┼───┼───┼───┤
 * │   │   │  │  │   │      │ 󰿏 │   │   │   │   │
 * └───┴───┴───┴───┴───┘      └───┴───┴───┴───┴───┘
 *               ┌───┬───┐  ┌───┬───┐            
 *               │   │   │  │   │  │            
 *               └───┴───┘  └───┴───┘            
 */
ZMK_LAYER(launch,
    &trans               &kp C_AL_WWW  &kp C_AL_FILES          &trans             &kp C_AL_FINANCE             &kp C_AL_TEXT_EDITOR  &kp C_AL_WORD  &kp C_AL_SPREADSHEET  &kp C_AL_PRESENTATION  &kp C_AL_GRAPHICS_EDITOR
    &kp C_AL_CALCULATOR  &trans        &kp C_AL_CONTROL_PANEL  &kp LG(3)          &kp C_AL_TASK_MANAGER        &kp C_AL_MUSIC        &kp C_AL_NEWS  &kp C_AL_EMAIL        &kp C_AL_IMAGES        &kp C_AL_CONTACTS
    &trans               &trans        &kp C_AL_CALENDAR       &kp C_AL_DATABASE  &trans                       &kp C_AL_MOVIES       &trans         &trans                &trans                 &trans
                                                               &trans             &trans                       &trans                &trans
)

